generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model User {
  id           String         @id @default(cuid())
  email        String         @unique
  password     String
  name         String
  goal         String?
  stripeCustomerId String?    @unique
  createdAt    DateTime       @default(now())
  businesses   Business[]
  subscription Subscription?
}
model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String?  @unique
  plan                 String   @default("free")   // free | starter | growth | pro
  status               String   @default("active") // active | past_due | canceled
  addons               String   @default("[]")      // JSON array: ["auto_management","auto_marketing","premium_management","premium_marketing"]
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
model Business {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  tagline      String?
  location     String
  budget       Float
  hoursPerWeek Int
  status       String           @default("setup")
  ideaData     String
  intakeData   String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tasks        Task[]
  outputs      BusinessOutput[]
  integrations Integration[]
  @@index([userId])
}
model Task {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  category      String
  description   String
  status        String   @default("pending")
  mode          String   @default("auto")
  estimatedTime String?
  estimatedCost String?
  canAutomate   Boolean  @default(false)
  steps         String   @default("[]")
  outputData    String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([businessId])
}
model BusinessOutput {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String
  title      String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([businessId])
}
model Integration {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider     String
  status       String   @default("disconnected")
  accessToken  String?
  refreshToken String?
  metadata     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([businessId, provider])
}
